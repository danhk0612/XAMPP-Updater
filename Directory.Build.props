<Project>
  <PropertyGroup>
    <!-- Release version source of truth. Change this value immediately before a release. -->
    <VersionPrefix>0.1.14</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <Product>XAMPP Updater</Product>
    <Company>XAMPP Updater</Company>
  </PropertyGroup>
</Project>
