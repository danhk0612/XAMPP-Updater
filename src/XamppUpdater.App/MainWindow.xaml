<Window x:Class="XamppUpdater.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XAMPP Updater" Height="840" Width="1120"
        MinHeight="760" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="XAMPP Updater" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0" Foreground="DimGray"
                       Text="목표 버전을 선택하고 업데이트 전 백업 범위, 설정 파일과 실행 상태를 점검합니다. 아직 실제 파일 교체는 실행하지 않습니다." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="InstallPathComboBox" Grid.Column="0" Height="34" IsEditable="True" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,0" Content="자동 감지" Click="AutoDetectButton_Click" />
            <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,0" Content="폴더 선택" Click="BrowseButton_Click" />
            <Button Grid.Column="3" Margin="8,0,0,0" Padding="14,0" Content="확인" Click="InspectButton_Click" />
            <Button x:Name="OnlineCheckButton" Grid.Column="4" Margin="8,0,0,0" Padding="14,0" Content="온라인 확인" Click="OnlineCheckButton_Click" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,0,0,14" Foreground="DimGray" Text="XAMPP 설치 경로를 확인하는 중..." />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Apache" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="ApacheVersionText" Margin="0,14,0,0" FontSize="16" Text="-" />
                        <TextBlock x:Name="ApacheEnvironmentText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="DimGray" Text="환경: -" />
                        <TextBlock x:Name="ApacheLatestText" Margin="0,12,0,0" Text="upstream 최신: -" />
                        <TextBlock x:Name="ApacheXamppText" Margin="0,5,0,0" Text="XAMPP 공식: -" />
                        <TextBlock x:Name="ApacheCandidateText" Margin="0,5,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Text="실제 후보: -" />
                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="업데이트 버전" />
                        <ComboBox x:Name="ApacheTargetComboBox" Height="32" DisplayMemberPath="DisplayText" SelectionChanged="TargetVersion_SelectionChanged" IsEnabled="False" />
                        <TextBlock x:Name="ApachePlanText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkSlateGray" Text="업데이트 경로: 온라인 확인 후 선택할 수 있습니다." />
                        <Button x:Name="ApachePreflightButton" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="12,5" Content="업데이트 준비 점검" Tag="Apache" Click="PreflightButton_Click" IsEnabled="False" />
                        <TextBlock x:Name="ApachePreflightText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="DarkSlateGray" Text="준비 점검: 대상 버전 선택 후 실행할 수 있습니다." />
                        <TextBlock x:Name="ApacheCompatibilityText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkGoldenrod" />
                        <Separator Margin="0,12,0,8" />
                        <TextBlock x:Name="ApacheServiceText" TextWrapping="Wrap" Foreground="DimGray" Text="서비스: -" />
                        <TextBlock x:Name="ApachePathText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DimGray" Text="경로: -" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="PHP" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="PhpVersionText" Margin="0,14,0,0" FontSize="16" Text="-" />
                        <TextBlock x:Name="PhpEnvironmentText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="DimGray" Text="환경: -" />
                        <TextBlock x:Name="PhpLatestText" Margin="0,12,0,0" Text="upstream 최신: -" />
                        <TextBlock x:Name="PhpXamppText" Margin="0,5,0,0" Text="XAMPP 공식: -" />
                        <TextBlock x:Name="PhpCandidateText" Margin="0,5,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Text="실제 후보: -" />
                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="업데이트 버전" />
                        <ComboBox x:Name="PhpTargetComboBox" Height="32" DisplayMemberPath="DisplayText" SelectionChanged="TargetVersion_SelectionChanged" IsEnabled="False" />
                        <TextBlock x:Name="PhpPlanText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkSlateGray" Text="업데이트 경로: 온라인 확인 후 선택할 수 있습니다." />
                        <Button x:Name="PhpPreflightButton" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="12,5" Content="업데이트 준비 점검" Tag="Php" Click="PreflightButton_Click" IsEnabled="False" />
                        <TextBlock x:Name="PhpPreflightText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="DarkSlateGray" Text="준비 점검: 대상 버전 선택 후 실행할 수 있습니다." />
                        <TextBlock x:Name="PhpCompatibilityText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkGoldenrod" />
                        <Separator Margin="0,12,0,8" />
                        <TextBlock Foreground="DimGray" Text="서비스: 해당 없음" />
                        <TextBlock x:Name="PhpPathText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DimGray" Text="경로: -" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="MariaDB" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="MariaDbVersionText" Margin="0,14,0,0" FontSize="16" Text="-" />
                        <TextBlock x:Name="MariaDbEnvironmentText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="DimGray" Text="환경: -" />
                        <TextBlock x:Name="MariaDbLatestText" Margin="0,12,0,0" Text="upstream 최신: -" />
                        <TextBlock x:Name="MariaDbXamppText" Margin="0,5,0,0" Text="XAMPP 공식: -" />
                        <TextBlock x:Name="MariaDbCandidateText" Margin="0,5,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Text="실제 후보: -" />
                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="업데이트 버전" />
                        <ComboBox x:Name="MariaDbTargetComboBox" Height="32" DisplayMemberPath="DisplayText" SelectionChanged="TargetVersion_SelectionChanged" IsEnabled="False" />
                        <TextBlock x:Name="MariaDbPlanText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkSlateGray" Text="업데이트 경로: 온라인 확인 후 선택할 수 있습니다." />
                        <Button x:Name="MariaDbPreflightButton" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="12,5" Content="업데이트 준비 점검" Tag="MariaDb" Click="PreflightButton_Click" IsEnabled="False" />
                        <TextBlock x:Name="MariaDbPreflightText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="DarkSlateGray" Text="준비 점검: 대상 버전 선택 후 실행할 수 있습니다." />
                        <TextBlock x:Name="MariaDbCompatibilityText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkGoldenrod" />
                        <Separator Margin="0,12,0,8" />
                        <TextBlock x:Name="MariaDbServiceText" TextWrapping="Wrap" Foreground="DimGray" Text="서비스: -" />
                        <TextBlock x:Name="MariaDbPathText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DimGray" Text="경로: -" />
                        <TextBlock x:Name="MariaDbDetailText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkGoldenrod" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
