<Window x:Class="XamppUpdater.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XAMPP Updater" Height="560" Width="860"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="XAMPP Updater" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0" Foreground="DimGray"
                       Text="Apache / PHP / MariaDB 설치 상태와 현재 버전을 확인합니다. Phase 1에서는 시스템을 변경하지 않습니다." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="InstallPathComboBox" Grid.Column="0" Height="34" IsEditable="True" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,0" Content="자동 감지" Click="AutoDetectButton_Click" />
            <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,0" Content="폴더 선택" Click="BrowseButton_Click" />
            <Button Grid.Column="3" Margin="8,0,0,0" Padding="14,0" Content="확인" Click="InspectButton_Click" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,0,0,14" Foreground="DimGray" Text="XAMPP 설치 경로를 확인하는 중..." />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Apache" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="ApacheVersionText" Margin="0,14,0,0" FontSize="16" Text="-" />
                    <TextBlock x:Name="ApacheServiceText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DimGray" Text="서비스: -" />
                    <TextBlock x:Name="ApachePathText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DimGray" Text="경로: -" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="PHP" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="PhpVersionText" Margin="0,14,0,0" FontSize="16" Text="-" />
                    <TextBlock Margin="0,8,0,0" Foreground="DimGray" Text="서비스: 해당 없음" />
                    <TextBlock x:Name="PhpPathText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DimGray" Text="경로: -" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="MariaDB" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="MariaDbVersionText" Margin="0,14,0,0" FontSize="16" Text="-" />
                    <TextBlock x:Name="MariaDbServiceText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DimGray" Text="서비스: -" />
                    <TextBlock x:Name="MariaDbPathText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DimGray" Text="경로: -" />
                    <TextBlock x:Name="MariaDbDetailText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkGoldenrod" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
