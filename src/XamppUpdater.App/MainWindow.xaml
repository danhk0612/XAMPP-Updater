<Window x:Class="XamppUpdater.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XAMPP Updater" Height="820" Width="1180"
        MinHeight="700" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="XAMPP Updater" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Margin="0,3,0,0" Foreground="DimGray"
                           Text="Apache, PHP, MariaDB를 안전하게 업데이트하고 실패 시 자동 복원합니다." />
            </StackPanel>
            <TextBlock x:Name="PrivilegeText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Foreground="DimGray" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="XAMPP 경로" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
            <ComboBox x:Name="InstallPathComboBox" Grid.Column="1" Height="34" IsEditable="True"
                      VerticalContentAlignment="Center"
                      KeyDown="InstallPathComboBox_KeyDown"
                      DropDownClosed="InstallPathComboBox_DropDownClosed" />
            <Button Grid.Column="2" Margin="8,0,0,0" Padding="15,0" Content="찾아보기" Click="BrowseButton_Click" />
            <Button x:Name="OnlineCheckButton" Visibility="Collapsed" Click="OnlineCheckButton_Click" />
        </Grid>

        <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Foreground="DimGray" Text="XAMPP 설치 경로를 확인하는 중..." TextWrapping="Wrap" />
                    <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Margin="12,0,0,0" Foreground="DimGray" Text="" />
                </Grid>
                <ProgressBar x:Name="UpdateProgressBar" Grid.Row="1" Height="7" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="0" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel>
                    <TextBlock Text="구성요소" FontWeight="SemiBold" Margin="4,2,0,8" />
                    <Button x:Name="ApacheNavButton" Content="Apache" Tag="Apache" Height="38" Margin="0,0,0,5" Click="ComponentNav_Click" />
                    <Button x:Name="PhpNavButton" Content="PHP" Tag="Php" Height="38" Margin="0,0,0,5" Click="ComponentNav_Click" />
                    <Button x:Name="MariaDbNavButton" Content="MariaDB" Tag="MariaDb" Height="38" Click="ComponentNav_Click" />
                    <Separator Margin="0,14,0,12" />
                    <TextBlock Text="관리" FontWeight="SemiBold" Margin="4,0,0,8" />
                    <Button Content="설정 이력" Margin="0,0,0,5" Padding="8,6" Click="OpenSelectedConfigHistory_Click" />
                    <Button Content="저장 데이터 정리" Margin="0,0,0,5" Padding="8,6" Click="CleanupButton_Click" />
                    <Separator Margin="0,10,0,10" />
                    <TextBlock Text="탐색기로 열기" Foreground="DimGray" Margin="4,0,0,6" />
                    <Button Content="롤백 백업" Tag="Backups" Margin="0,0,0,4" Padding="8,5" Click="OpenStorageFolder_Click" />
                    <Button Content="설정 이력 폴더" Tag="ConfigHistory" Margin="0,0,0,4" Padding="8,5" Click="OpenStorageFolder_Click" />
                    <Button Content="캐시/임시 데이터" Tag="LocalRoot" Padding="8,5" Click="OpenStorageFolder_Click" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="6" Padding="18">
                <Grid>
                    <StackPanel x:Name="ApachePanel">
                        <TextBlock Text="Apache" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Margin="0,18,0,3" Foreground="DimGray" Text="현재 버전" />
                        <TextBlock x:Name="ApacheVersionText" FontSize="18" FontWeight="SemiBold" Text="-" />
                        <TextBlock Margin="0,18,0,5" Foreground="DimGray" Text="업데이트 버전" />
                        <ComboBox x:Name="ApacheTargetComboBox" Height="34" DisplayMemberPath="DisplayText" SelectionChanged="TargetVersion_SelectionChanged" IsEnabled="False" />
                        <TextBlock x:Name="ApachePlanText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="DarkSlateGray" Text="업데이트 정보를 확인하는 중입니다." />
                        <Button x:Name="ApachePrimaryUpdateButton" Margin="0,20,0,0" Height="42" Content="Apache 업데이트" Tag="Apache" Click="PrimaryUpdateButton_Click" IsEnabled="False" />
                        <Expander Header="고급 정보" Margin="0,14,0,0">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="ApacheEnvironmentText" TextWrapping="Wrap" Foreground="DimGray" />
                                <TextBlock x:Name="ApacheServiceText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="DimGray" />
                                <TextBlock x:Name="ApachePathText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="DimGray" />
                                <TextBlock x:Name="ApacheLatestText" Visibility="Collapsed" />
                                <TextBlock x:Name="ApacheXamppText" Visibility="Collapsed" />
                                <TextBlock x:Name="ApacheCandidateText" Visibility="Collapsed" />
                                <TextBlock x:Name="ApacheCompatibilityText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="DarkGoldenrod" />
                            </StackPanel>
                        </Expander>
                        <StackPanel Visibility="Collapsed">
                            <WrapPanel>
                                <Button x:Name="ApachePreflightButton" Tag="Apache" Click="PreflightButton_Click" />
                                <Button x:Name="ApacheBackupButton" Tag="Apache" Click="BackupButton_Click" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button x:Name="ApachePackageButton" Tag="Apache" Click="PackageButton_Click" />
                                <Button x:Name="ApacheDiffButton" Tag="Apache" Click="DiffButton_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="ApachePreflightText" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="PhpPanel" Visibility="Collapsed">
                        <TextBlock Text="PHP" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Margin="0,18,0,3" Foreground="DimGray" Text="현재 버전" />
                        <TextBlock x:Name="PhpVersionText" FontSize="18" FontWeight="SemiBold" Text="-" />
                        <TextBlock Margin="0,18,0,5" Foreground="DimGray" Text="업데이트 버전" />
                        <ComboBox x:Name="PhpTargetComboBox" Height="34" DisplayMemberPath="DisplayText" SelectionChanged="TargetVersion_SelectionChanged" IsEnabled="False" />
                        <TextBlock x:Name="PhpPlanText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="DarkSlateGray" Text="업데이트 정보를 확인하는 중입니다." />
                        <Button x:Name="PhpPrimaryUpdateButton" Margin="0,20,0,0" Height="42" Content="PHP 업데이트" Tag="Php" Click="PrimaryUpdateButton_Click" IsEnabled="False" />
                        <Expander Header="고급 정보" Margin="0,14,0,0">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="PhpEnvironmentText" TextWrapping="Wrap" Foreground="DimGray" />
                                <TextBlock x:Name="PhpPathText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="DimGray" />
                                <TextBlock x:Name="PhpLatestText" Visibility="Collapsed" />
                                <TextBlock x:Name="PhpXamppText" Visibility="Collapsed" />
                                <TextBlock x:Name="PhpCandidateText" Visibility="Collapsed" />
                                <TextBlock x:Name="PhpCompatibilityText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="DarkGoldenrod" />
                            </StackPanel>
                        </Expander>
                        <StackPanel Visibility="Collapsed">
                            <WrapPanel>
                                <Button x:Name="PhpPreflightButton" Tag="Php" Click="PreflightButton_Click" />
                                <Button x:Name="PhpBackupButton" Tag="Php" Click="BackupButton_Click" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button x:Name="PhpPackageButton" Tag="Php" Click="PackageButton_Click" />
                                <Button x:Name="PhpDiffButton" Tag="Php" Click="DiffButton_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="PhpPreflightText" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="MariaDbPanel" Visibility="Collapsed">
                        <TextBlock Text="MariaDB" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Margin="0,18,0,3" Foreground="DimGray" Text="현재 버전" />
                        <TextBlock x:Name="MariaDbVersionText" FontSize="18" FontWeight="SemiBold" Text="-" />
                        <TextBlock Margin="0,18,0,5" Foreground="DimGray" Text="업데이트 버전" />
                        <ComboBox x:Name="MariaDbTargetComboBox" Height="34" DisplayMemberPath="DisplayText" SelectionChanged="TargetVersion_SelectionChanged" IsEnabled="False" />
                        <TextBlock x:Name="MariaDbPlanText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="DarkSlateGray" Text="업데이트 정보를 확인하는 중입니다." />
                        <Button x:Name="MariaDbPrimaryUpdateButton" Margin="0,20,0,0" Height="42" Content="MariaDB 업데이트" Tag="MariaDb" Click="PrimaryUpdateButton_Click" IsEnabled="False" />
                        <Expander Header="고급 정보" Margin="0,14,0,0">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="MariaDbEnvironmentText" TextWrapping="Wrap" Foreground="DimGray" />
                                <TextBlock x:Name="MariaDbServiceText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="DimGray" />
                                <TextBlock x:Name="MariaDbPathText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="DimGray" />
                                <TextBlock x:Name="MariaDbDetailText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="DarkGoldenrod" />
                                <TextBlock x:Name="MariaDbLatestText" Visibility="Collapsed" />
                                <TextBlock x:Name="MariaDbXamppText" Visibility="Collapsed" />
                                <TextBlock x:Name="MariaDbCandidateText" Visibility="Collapsed" />
                                <TextBlock x:Name="MariaDbCompatibilityText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="DarkGoldenrod" />
                            </StackPanel>
                        </Expander>
                        <StackPanel Visibility="Collapsed">
                            <WrapPanel>
                                <Button x:Name="MariaDbPreflightButton" Tag="MariaDb" Click="PreflightButton_Click" />
                                <Button x:Name="MariaDbBackupButton" Tag="MariaDb" Click="BackupButton_Click" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button x:Name="MariaDbPackageButton" Tag="MariaDb" Click="PackageButton_Click" />
                                <Button x:Name="MariaDbDiffButton" Tag="MariaDb" Click="DiffButton_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="MariaDbPreflightText" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="작업 로그" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,8" />
                    <TextBox x:Name="ActivityLogTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" BorderThickness="0" />
                    <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="12,5" Content="최근 작업 로그 열기" Click="OpenSelectedRecentLog_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
